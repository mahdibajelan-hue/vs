# فرین PMIS — Apache / LiteSpeed (cPanel, DirectAdmin, Plesk on Linux)
# The app is one page: every screen is index.html plus query strings, so no rewrite rules are needed.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType image/webp .webp
  AddType application/json .json
  AddType text/javascript .js .mjs
  AddCharset utf-8 .js .css .html .json
</IfModule>

# gzip text files (most shared hosts have mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>

# index.html must always be fresh (it names the current build's files and drives the in-app «نسخهٔ جدید» notice);
# files under assets/ carry a content hash in their names; assets/.htaccess caches them for a year.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Disable powerful features the app never uses (camera, geolocation and WebAuthn
  # stay on by browser default — do NOT add them here as disabled).
  Header always set Permissions-Policy "microphone=(), payment=(), usb=()"
  # HSTS — only sent over HTTPS. Drop includeSubDomains if the app shares a domain with other apps.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  # Content-Security-Policy — shipped in REPORT-ONLY so it never breaks the app. Watch the browser
  # console for violations (Cesium wasm/workers, Google Fonts, Supabase, inline styles are allowed
  # below); once clean, rename the header to "Content-Security-Policy" to enforce it.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.cesium.com https://assets.ion.cesium.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://fonts.googleapis.com https://*.cesium.com https://assets.ion.cesium.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
