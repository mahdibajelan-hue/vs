# فرین PMIS — nginx (VPS). Point root at the folder that holds index.html.
server {
  listen 80;
  server_name pmis.example.ir;   # ← your domain; add HTTPS (certbot) — passkeys, camera and location need it
  root /var/www/farin-pmis;
  index index.html;

  types { application/wasm wasm; }
  gzip on;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml application/wasm;

  # Security headers (sent on every response). camera/geolocation/WebAuthn stay on by default.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Permissions-Policy "microphone=(), payment=(), usb=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;  # only honored over HTTPS
  # CSP shipped REPORT-ONLY so it never breaks the app; once the browser console is clean, rename the
  # header to "Content-Security-Policy" to enforce. (nginx note: a location block that sets its own
  # add_header must repeat these, as add_header does not inherit once redefined in a nested block.)
  add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.cesium.com https://assets.ion.cesium.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://fonts.googleapis.com https://*.cesium.com https://assets.ion.cesium.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

  location = /index.html { add_header Cache-Control "no-cache, must-revalidate"; }
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / { try_files $uri $uri/ /index.html; }
}
