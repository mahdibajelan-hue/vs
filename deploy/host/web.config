<?xml version="1.0" encoding="utf-8"?>
<!-- فرین PMIS — IIS (Windows hosting / Plesk on Windows). One page app: no URL rewrite needed. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
    <urlCompression doStaticCompression="true" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- Disable powerful features the app never uses; camera/geolocation/WebAuthn stay on by default. -->
        <add name="Permissions-Policy" value="microphone=(), payment=(), usb=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- CSP shipped REPORT-ONLY so it never breaks the app. After confirming no violations in the
             browser console, rename to "Content-Security-Policy" to enforce. -->
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.cesium.com https://assets.ion.cesium.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://fonts.googleapis.com https://*.cesium.com https://assets.ion.cesium.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- index.html always fresh; hashed files in assets/ cached for a year -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
